# Variáveis de ambiente da app. Copia este ficheiro para ".env" (na mesma pasta) e preenche-o.
# O .env não vai para o Git; o scripts/gerar-environment.mjs lê-o antes de "npm start" e dos builds.
#
# Valores no painel do Supabase: Project Settings → API Keys (e o Project URL em Data API).
# Usa SEMPRE a chave pública (publishable). A chave secreta nunca entra aqui.

SUPABASE_URL=https://<ref-do-projeto>.supabase.co
SUPABASE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
